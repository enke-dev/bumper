{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "target": "ESNext",
    "types": ["bun"],
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "packages/cli/src/**/*.ts",
    "packages/core/src/**/*.ts",
    "eslint.config.ts",
    "prettier.config.ts"
  ],
  "exclude": ["**/dist", "**/node_modules"]
}
