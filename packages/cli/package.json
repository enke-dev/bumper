{
  "name": "@enke.dev/bumper",
  "version": "0.15.0",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "description": "Central, feature-based repo updater: bumps Node/deps/actions across node, pnpm, npm and bun repos.",
  "author": {
    "name": "David Enke",
    "email": "david@enke.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enke-dev/bumper.git"
  },
  "type": "module",
  "bin": {
    "bmpr": "./dist/cli.mjs",
    "bumper": "./dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs",
    "assets/icon/icon.png"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "bun run build",
    "prepack": "cp ../../README.md ../../LICENSE .",
    "dev": "bun run --bun src/cli.ts",
    "build": "bun run --cwd ../ui build && bun build ./src/cli.ts --target=node --outfile dist/cli.mjs"
  },
  "dependencies": {
    "@swimlane/docker-reference": "2.0.1",
    "semver-utils": "1.1.4",
    "verkit": "0.5.0"
  },
  "devDependencies": {
    "@enke.dev/bumper-core": "workspace:*"
  }
}
