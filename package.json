{
  "name": "bumper",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "description": "Monorepo for @enke.dev/bumper (packages/cli) and its library (packages/core).",
  "author": {
    "name": "David Enke",
    "email": "david@enke.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enke-dev/bumper.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "tsgo --noEmit && tsgo -p packages/ui --noEmit",
    "lint": "run-p lint:*",
    "lint:eslint": "bun --bun eslint --config eslint.config.ts",
    "lint:prettier": "bun --bun prettier --config prettier.config.ts --check .",
    "format": "run-p format:*",
    "format:eslint": "bun --bun eslint --config eslint.config.ts --fix",
    "format:prettier": "bun --bun prettier --config prettier.config.ts --write .",
    "test": "run-p -c test:*",
    "test:bun": "bun test --reporter=junit --reporter-outfile=reports/junit.bun.xml",
    "test:node": "node --import tsx --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/junit.node.xml \"packages/*/src/**/*.spec.ts\"",
    "dev": "bun run --bun packages/cli/src/cli.ts",
    "build": "bun run --filter @enke.dev/bumper-ui build && bun run --filter @enke.dev/bumper build",
    "build:binaries": "sh scripts/build-binaries.sh",
    "dev:ui": "bun run --filter @enke.dev/bumper-ui dev",
    "dev:manage": "bun run --bun packages/cli/src/cli.ts manage --port 3131 --no-open"
  },
  "devDependencies": {
    "@enke.dev/lint": "0.13.13",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.2",
    "@types/semver-utils": "1.1.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "10.11.0",
    "jiti": "2.7.0",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
